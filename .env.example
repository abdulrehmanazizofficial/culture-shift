# QLOO_API_KEY: Official Qloo Taste AI API Key for the Agentic Hackathon.
# Handled strictly server-side using the X-Api-Key header.
# Target Base URL: https://hackathon.api.qloo.com
QLOO_API_KEY="YOUR_QLOO_HACKATHON_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI strategic synthesis and analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
